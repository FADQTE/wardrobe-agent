# ===== LLM（OpenAI 兼容：DeepSeek / 通义 / Kimi / Ollama 均可）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3

# 无 Key 时演示模式：true 则 Agent 走脚本化回复，全链路仍可演示
MOCK_AGENT=false

# ===== Embedding: ollama(本地 qwen3-embedding:0.6b) | api | none(纯BM25降级) =====
EMBEDDING_MODE=none
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024
OLLAMA_URL=http://localhost:11434

# ===== Reranker（Qwen3-Reranker-0.6B 本地 cross-encoder，Ollama 不支持 rerank，代码内部署）=====
RERANK_ENABLED=true
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANK_MODEL_DIR=D:\ago\agent\agent-python\.models
RERANK_TOP_N=20
RERANK_THRESHOLD=0.3

# ===== 基础设施 =====
ES_URL=http://localhost:9200
JAVA_MCP_URL=http://localhost:8080/mcp/sse
JAVA_API_URL=http://localhost:8080/api

# ===== 生图（mock 模式固定走本地模拟）=====
TRYON_MODE=mock
