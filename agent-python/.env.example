# ===== LLM（OpenAI 兼容：DeepSeek / 通义 / Kimi / Ollama 均可）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.3
# 思考强度：off | enabled | max（DeepSeek thinking schema，max 附 16384 思考预算）
LLM_THINKING=max

# 无 Key 时的本地模式：true 则 Agent 使用脚本化回复
MOCK_AGENT=false

# ===== Embedding: ollama(本地 qwen3-embedding:0.6b) | api | none(纯BM25降级) =====
EMBEDDING_MODE=none
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024
OLLAMA_URL=http://localhost:11434

# ===== Reranker（Qwen3-Reranker-0.6B 本地 cross-encoder，Ollama 不支持 rerank，代码内部署）=====
RERANK_ENABLED=true
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
# 留空时自动使用 agent-python/.models，避免机器相关的绝对路径
RERANK_MODEL_DIR=
RERANK_TOP_N=20
RERANK_THRESHOLD=0.3

# ===== Hybrid RAG（BM25 与 kNN 独立召回，RRF 融合）=====
HYBRID_RRF_K=60
HYBRID_LEXICAL_WEIGHT=1.0
HYBRID_VECTOR_WEIGHT=0.8
HYBRID_CANDIDATE_WINDOW=50

# ===== 基础设施 =====
ES_URL=http://localhost:16544
JAVA_MCP_URL=http://localhost:16545/mcp/sse
JAVA_API_URL=http://localhost:16545/api

# ===== 虚拟试衣：mock=本地预设图；http=接真实生图供应商 =====
TRYON_MODE=mock
# http 模式约定：POST 返回 resultUrl，或返回 taskId/statusUrl 供轮询
TRYON_PROVIDER_URL=
TRYON_PROVIDER_API_KEY=
TRYON_PROVIDER_TIMEOUT=60
TRYON_POLL_INTERVAL=1.5
TRYON_POLL_TIMEOUT=180
# Java 内部接口鉴权（必须与 backend-java 的 APP_INTERNAL_API_KEY 一致）
APP_INTERNAL_API_KEY=local-internal-key
